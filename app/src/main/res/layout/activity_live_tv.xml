<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Panoramic Background -->
    <ImageView
        android:id="@+id/ivAppBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/app_background"
        android:scaleType="centerCrop" />

    <!-- Dark Overlay for Readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Panel 1: Sidebar Categories -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.8"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="?attr/colorSidebarCustom">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MENU"
                android:textColor="?attr/colorPrimaryCustom"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategories"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="true"
                android:nextFocusRight="@+id/rvCategories"
                android:nextFocusUp="@+id/rvCategories"
                android:nextFocusDown="@+id/rvCategories"
                android:nextFocusLeft="@+id/rvCategories"
                android:descendantFocusability="afterDescendants" />
        </LinearLayout>

        <!-- Panel 2: Channels -->
        <LinearLayout
            android:id="@+id/panelChannels"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2.8"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"
                android:background="@drawable/glass_card_bg"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvPanelTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="KANALLAR"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:hint="Axtar..."
                    android:textColorHint="#80FFFFFF"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:background="@android:color/transparent"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:nextFocusDown="@+id/rvChannels"
                    android:nextFocusLeft="@+id/rvCategories" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChannels"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="true"
                android:clipToPadding="false"
                android:padding="8dp"
                android:nextFocusLeft="@+id/rvChannels"
                android:nextFocusUp="@+id/rvChannels"
                android:nextFocusDown="@+id/rvChannels"
                android:nextFocusRight="@+id/rvChannels"
                android:descendantFocusability="afterDescendants" />
        </LinearLayout>

        <!-- Panel 3: Mini Player & EPG -->
        <LinearLayout
            android:id="@+id/panelPlayer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3.4"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="?attr/colorSidebarCustom">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="260dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                android:backgroundTint="@color/black">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/miniPlayerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:use_controller="false"
                    app:use_artwork="false"
                    app:surface_type="surface_view"
                    android:keepScreenOn="true" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp">

                <ImageView
                    android:id="@+id/ivCurrentChannelLogo"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/glass_card_bg"
                    android:padding="4dp"
                    android:src="@drawable/default_logo" />

                <TextView
                    android:id="@+id/tvCurrentChannel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Seçin..."
                    android:textColor="?attr/colorPrimaryCustom"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginStart="16dp" />

                <Button
                    android:id="@+id/btnBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GERİ"
                    android:backgroundTint="@color/glass_white_heavy"
                    android:textColor="@color/white"
                    android:layout_marginStart="8dp"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEpgTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EPG Məlumatı yoxdur"
                android:textColor="@android:color/darker_gray"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />

            <ProgressBar
                android:id="@+id/epgProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:progress="0"
                android:progressTint="@android:color/holo_blue_light" />

        </LinearLayout>

    </LinearLayout>

    <!-- Background Loading Indicator -->
    <LinearLayout
        android:id="@+id/mainLoadingLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:elevation="100dp">

        <ProgressBar
            android:id="@+id/mainLoadingProgress"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:indeterminateTint="?attr/colorPrimaryCustom" />

        <TextView
            android:id="@+id/tvMainLoadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Yüklənir..."
            android:textColor="?attr/colorPrimaryCustom"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Right Test Countdown (Banner Style) -->
    <LinearLayout
        android:id="@+id/testBannerLive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:background="@drawable/glass_card_bg"
        android:orientation="vertical"
        android:gravity="end"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:visibility="gone"
        android:elevation="10dp">

        <TextView
            android:id="@+id/testTitleLive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧪 TEST REJİMİ"
            android:textColor="#60a5fa"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/testTimerLive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱ 00:00:00"
            android:textColor="#60a5fa"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />
    </LinearLayout>

</FrameLayout>
