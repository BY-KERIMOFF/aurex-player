<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:use_artwork="false"
        android:keepScreenOn="true"
        app:surface_type="surface_view"
        app:resize_mode="fill" />

    <FrameLayout
        android:id="@+id/announcementContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="10dp"
        android:background="#80000000"
        android:paddingVertical="4dp"
        android:visibility="gone"
        android:elevation="200dp">

        <TextView
            android:id="@+id/tvAnnouncement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:text="Aurex Player" />
    </FrameLayout>

    <!-- Modernized OSD -->
    <LinearLayout
        android:id="@+id/osdLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/osd_gradient"
        android:orientation="vertical"
        android:paddingHorizontal="36dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp"
        android:elevation="50dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivChannelLogo"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:scaleType="fitCenter"
                android:background="@android:color/white"
                android:padding="4dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="24dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvChannelName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEpgInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#D0FFFFFF"
                    android:textSize="20sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                android:layout_marginStart="16dp">

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="HH:mm"
                    android:format24Hour="HH:mm"
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvQuality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="..."
                    android:layout_marginTop="6dp"
                    android:background="@color/gold_primary"
                    android:textColor="@android:color/black"
                    android:textStyle="bold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvFps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/gold_primary"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvPlayerTestCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Test: --:--"
                    android:textColor="@color/gold_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- VOD Progress Bar & Timers -->
        <LinearLayout
            android:id="@+id/vodProgressLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvCurrentPosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <SeekBar
                android:id="@+id/vodSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="12dp"
                android:progressTint="@color/gold_primary"
                android:thumbTint="@color/gold_primary" />

            <TextView
                android:id="@+id/tvTotalDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/volumeLayout"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="120dp"
        android:background="@drawable/glass_card_bg"
        android:padding="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:elevation="20dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_lock_silent_mode_off"
            app:tint="@color/white"
            android:layout_marginEnd="12dp" />

        <ProgressBar
            android:id="@+id/volumeProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:layout_weight="1"
            android:max="100"
            android:progressDrawable="@drawable/volume_progress_drawable" />

        <TextView
            android:id="@+id/tvVolumePercent"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="end"
            android:layout_marginStart="16dp"
            android:text="0%" />
    </LinearLayout>

    <!-- Sürətli Kanal Siyahısı Overlay (Pleyerdə OK basıldıqda açılır) -->
    <LinearLayout
        android:id="@+id/playerChannelSidebar"
        android:layout_width="350dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#CC000000"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvPlayerSidebarTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KANALLAR"
            android:textColor="@color/gold_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="3" />

        <EditText
            android:id="@+id/etPlayerSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/glass_card_bg"
            android:hint="Kanal axtar..."
            android:textColorHint="#80FFFFFF"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:padding="10dp"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:nextFocusDown="@+id/rvPlayerChannels" />



        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPlayerChannels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:clickable="true"
            android:descendantFocusability="afterDescendants" />
    </LinearLayout>

    <!-- Arxiv Siyahısı Overlay (Pleyerdə OK uzun basıldıqda açılır) -->
    <LinearLayout
        android:id="@+id/playerArchiveSidebar"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#E6000000"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvArchiveTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KANAL ARXİVİ"
            android:textColor="@color/gold_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvArchive"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:clickable="true"
            android:descendantFocusability="afterDescendants" />
    </LinearLayout>

    <!-- Səs və Altyazı Siyahısı Overlay (Pleyerdə Rəngli Düymələr basıldıqda açılır) -->
    <LinearLayout
        android:id="@+id/playerTracksSidebar"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#E6000000"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvTracksTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SƏS DİLLƏRİ"
            android:textColor="@color/gold_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTracks"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:focusable="true"
            android:clickable="true"
            android:descendantFocusability="afterDescendants" />

        <Button
            android:id="@+id/btnSearchSubtitles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Onlayn Axtar"
            android:backgroundTint="@color/gold_dark"
            android:textColor="@color/white"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPlayerCategories"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#CC000000"
        android:padding="16dp"
        android:visibility="gone"
        android:focusable="true"
        android:clickable="true"
        android:descendantFocusability="afterDescendants" />

    <!-- Sağ aşağı künc üçün Mini Saat və Keyfiyyət Paneli -->
    <LinearLayout
        android:id="@+id/miniInfoLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="32dp"
        android:background="@drawable/glass_card_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvQualityCorner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="..."
            android:background="@color/gold_primary"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvFpsCorner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/gold_primary"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginStart="8dp" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <!-- Daimi Test Geri Sayımı (Banner Style) -->
    <LinearLayout
        android:id="@+id/testBannerPlayer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="70dp"
        android:background="@drawable/glass_card_bg"
        android:orientation="vertical"
        android:gravity="end"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:visibility="gone"
        android:elevation="10dp">

        <TextView
            android:id="@+id/testTitlePlayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧪 TEST REJİMİ"
            android:textColor="@color/gold_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/testWarningPlayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️ Test vaxtı bitir!"
            android:textColor="#fbbf24"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/testTimerPlayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱ 00:00:00"
            android:textColor="@color/gold_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bufferingLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/bufferingProgress"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:indeterminateTint="@android:color/white" />

        <TextView
            android:id="@+id/tvBufferingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Yüklənir..."
            android:textColor="@color/gold_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4" />
    </LinearLayout>

    <!-- Texniki Nasazlıq Ekranı -->
    <LinearLayout
        android:id="@+id/errorLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="100dp">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@android:drawable/ic_dialog_alert"
            app:tint="@color/gold_primary" />

        <TextView
            android:id="@+id/tvErrorTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="MÜVƏQQƏTİ TEXNİKİ NASAZLIQ"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingHorizontal="40dp"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tvErrorSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Yayım tezliklə bərpa olunacaq"
            android:textColor="@color/gold_dark"
            android:textSize="20sp"
            android:alpha="0.8" />
    </LinearLayout>

    <!-- Rəqəmlə Kanal Seçimi üçün Overlay -->
    <TextView
        android:id="@+id/tvNumericInput"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/glass_card_bg"
        android:paddingHorizontal="40dp"
        android:paddingVertical="20dp"
        android:textColor="@color/white"
        android:textSize="80sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:elevation="30dp"
        android:text="0" />

    <!-- Görüntü Rejimi Bildirişi -->
    <TextView
        android:id="@+id/tvAspectRatioStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="100dp"
        android:background="@drawable/glass_card_bg"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:textColor="@color/gold_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:elevation="50dp"
        android:text="Görüntü: Tam Ekran" />

</FrameLayout>
