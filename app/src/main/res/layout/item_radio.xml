<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:focusable="true"
    android:clickable="true"
    android:background="@drawable/item_selector"
    android:layout_marginBottom="4dp">

    <ImageView
        android:id="@+id/ivRadioLogo"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:scaleType="centerInside"
        android:background="@drawable/glass_card_bg"
        android:padding="4dp"
        android:src="@android:drawable/ic_lock_silent_mode_off" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRadioName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_focus_selector"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRadioTags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_focus_selector"
            android:alpha="0.7"
            android:textSize="14sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivPlaying"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/ic_media_play"
        android:visibility="gone"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        app:tint="@color/gold_primary" />

</LinearLayout>
