<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Panoramic Background -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerViewBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:resize_mode="fill"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/ivAppBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/app_background"
        android:scaleType="centerCrop" />

    <!-- Dark Overlay for Readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TƏNZİMLƏMƏLƏR"
                    android:textColor="@color/gold_primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GERİ"
                    android:backgroundTint="@color/glass_white_heavy"
                    android:textColor="@color/white" />
            </LinearLayout>

            <!-- Account Info Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hesab Məlumatları"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/bg_sidebar"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/glass_card_bg">

                    <TextView
                        android:id="@+id/tvMacAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MAC: --"
                        android:textColor="@color/white"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tvExpiryDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Bitiş Tarixi: --"
                        android:textColor="@color/gold_primary"
                        android:textSize="18sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- App Settings -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tətbiq Ayarları"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/bg_sidebar"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/glass_card_bg">

                    <CheckBox
                    android:id="@+id/cbBootOnStartup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cihaz açılarkən avtomatik başlat"
                    android:textColor="@color/white"
                    android:buttonTint="@color/gold_primary" />

                <CheckBox
                    android:id="@+id/cbAutoStartLast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Son baxılan kanalı avtomatik başlat"
                    android:textColor="@color/white"
                    android:buttonTint="@color/gold_primary" />

                <CheckBox
                    android:id="@+id/cbUseExternalPlayer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Videoları xarici pleyerlə aç (VLC, MX Player)"
                    android:textColor="@color/white"
                    android:buttonTint="@color/gold_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Video Player Rejimi:"
                        android:textColor="@color/gold_primary"
                        android:textSize="16sp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp" />

                    <RadioGroup
                        android:id="@+id/rgPlayerChoice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rbExoStandard"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Standart Exo"
                            android:textColor="@color/white"
                            android:buttonTint="@color/gold_primary" />

                        <RadioButton
                            android:id="@+id/rbExo2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Exo 2 / V2 (Sürətli və Stabil)"
                            android:textColor="@color/white"
                            android:buttonTint="@color/gold_primary" />
                    </RadioGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kateqoriya Sıralaması:"
                        android:textColor="@color/gold_primary"
                        android:textSize="16sp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp" />

                    <RadioGroup
                        android:id="@+id/rgSortChoice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <RadioButton android:id="@+id/rbSortDefault" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Default (Server sırası)" android:textColor="@color/white" android:buttonTint="@color/gold_primary" />
                        <RadioButton android:id="@+id/rbSortName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Əlifba Sırası (A-Z)" android:textColor="@color/white" android:buttonTint="@color/gold_primary" />
                        <RadioButton android:id="@+id/rbSortCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kanal Sayına Görə" android:textColor="@color/white" android:buttonTint="@color/gold_primary" />
                    </RadioGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xarici EPG Linki (M3U üçün):"
                        android:textColor="@color/gold_primary"
                        android:textSize="16sp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/etEpgUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="https://example.com/epg.xml"
                        android:textColorHint="#80FFFFFF"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:background="@drawable/glass_card_bg"
                        android:padding="12dp"
                        android:inputType="textUri" />

                    <Button
                        android:id="@+id/btnRefreshData"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Məlumatları Yenilə (Sync)"
                        android:backgroundTint="@color/glass_white_heavy"
                        android:textColor="@color/white" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Network & View Settings -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Şəbəkə və Görünüş"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/bg_sidebar"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/glass_card_bg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DNS Parametrləri (Bloklamaları keçmək üçün):"
                        android:textColor="@color/gold_primary"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <RadioGroup
                        android:id="@+id/rgDnsChoice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <RadioButton android:id="@+id/rbDnsSystem" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sistem DNS (Default)" android:textColor="@color/white" android:buttonTint="@color/gold_primary" />
                        <RadioButton android:id="@+id/rbDnsGoogle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Google DNS (8.8.8.8)" android:textColor="@color/white" android:buttonTint="@color/gold_primary" />
                        <RadioButton android:id="@+id/rbDnsCloudflare" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cloudflare DNS (1.1.1.1)" android:textColor="@color/white" android:buttonTint="@color/gold_primary" />
                        <RadioButton android:id="@+id/rbDnsManual" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Manual DNS (DoH URL)" android:textColor="@color/white" android:buttonTint="@color/gold_primary" />
                    </RadioGroup>

                    <EditText
                        android:id="@+id/etDnsManualUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="https://dns.adguard.com/dns-query"
                        android:textColorHint="#80FFFFFF"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:background="@drawable/glass_card_bg"
                        android:padding="12dp"
                        android:visibility="gone"
                        android:imeOptions="actionDone"
                        android:inputType="textUri" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kanal Siyahısı Görünüşü:"
                        android:textColor="@color/gold_primary"
                        android:textSize="16sp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp" />

                    <RadioGroup
                        android:id="@+id/rgViewChoice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <RadioButton android:id="@+id/rbViewClassic" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Klassik (Böyük Loqo)" android:textColor="@color/white" android:buttonTint="@color/gold_primary" />
                        <RadioButton android:id="@+id/rbViewList" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Səliqəli (Siyahı)" android:textColor="@color/white" android:buttonTint="@color/gold_primary" />
                        <RadioButton android:id="@+id/rbViewCompact" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kompakt (Kiçik)" android:textColor="@color/white" android:buttonTint="@color/gold_primary" />
                    </RadioGroup>

                    <CheckBox
                        android:id="@+id/cbDataSaver"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="İnternet Trafikinə Qənaət (Data Saver)"
                        android:textColor="@color/white"
                        android:buttonTint="@color/gold_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Buffer (Keşləmə) Müddəti:"
                        android:textColor="@color/gold_primary"
                        android:textSize="16sp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp" />

                    <RadioGroup
                        android:id="@+id/rgBufferChoice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <RadioButton android:id="@+id/rbBuffer0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 saniyə (Gecikməsiz - Sürətli internet)" android:textColor="@color/white" android:buttonTint="@color/gold_primary" />
                        <RadioButton android:id="@+id/rbBuffer5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5 saniyə (Normal)" android:textColor="@color/white" android:buttonTint="@color/gold_primary" />
                        <RadioButton android:id="@+id/rbBuffer10" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10 saniyə (Stabil - Orta internet)" android:textColor="@color/white" android:buttonTint="@color/gold_primary" />
                        <RadioButton android:id="@+id/rbBuffer30" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="30 saniyə (Maksimum - Zəif internet)" android:textColor="@color/white" android:buttonTint="@color/gold_primary" />
                    </RadioGroup>

                    <CheckBox
                        android:id="@+id/cbSmartBuffer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Smart Buffer (Avtomatik Gecikmə Tənzimləmə)"
                        android:textColor="@color/white"
                        android:buttonTint="@color/gold_primary" />

                    <Button
                        android:id="@+id/btnSpeedTest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="İnternet Sürət Testi (Speed Test)"
                        android:backgroundTint="@color/gold_dark"
                        android:textColor="@color/white" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Sleep Timer Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yuxu Taymeri"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/bg_sidebar"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/glass_card_bg">

                    <TextView
                        android:id="@+id/tvCurrentTimerStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status: Qapalı"
                        android:textColor="@color/gold_primary"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnTimerOff"
                            style="?android:attr/buttonStyleSmall"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="OFF"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/btnTimer15"
                            style="?android:attr/buttonStyleSmall"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="15 dk"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/btnTimer30"
                            style="?android:attr/buttonStyleSmall"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="30 dk"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/btnTimer60"
                            style="?android:attr/buttonStyleSmall"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="60 dk"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/btnTimer120"
                            style="?android:attr/buttonStyleSmall"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="120 dk" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- App Lock Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Təhlükəsizlik"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/bg_sidebar"
                android:layout_marginBottom="40dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/glass_card_bg">

                    <CheckBox
                        android:id="@+id/cbAppLock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tətbiq Kilidini Aktiv Et"
                        android:textColor="@color/white"
                        android:buttonTint="@color/gold_primary" />

                    <CheckBox
                        android:id="@+id/cbHideSensitive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Həssas (+18) kateqoriyaları tam gizlə"
                        android:textColor="@color/white"
                        android:buttonTint="@color/gold_primary" />

                    <Button
                        android:id="@+id/btnChangePin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="PİN KODU DƏYİŞDİR"
                        android:backgroundTint="@color/glass_white_heavy"
                        android:textColor="@color/white"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Wallpaper Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tətbiq Teması (Rəng)"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/bg_sidebar"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center"
                    android:background="@drawable/glass_card_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">
                        <View android:id="@+id/themeNeonBlue" android:layout_width="45dp" android:layout_height="45dp" android:layout_margin="8dp" android:background="#00E5FF" android:focusable="true" android:clickable="true" />
                        <View android:id="@+id/themeGold" android:layout_width="45dp" android:layout_height="45dp" android:layout_margin="8dp" android:background="#FFD700" android:focusable="true" android:clickable="true" />
                        <View android:id="@+id/themeRed" android:layout_width="45dp" android:layout_height="45dp" android:layout_margin="8dp" android:background="#FF0040" android:focusable="true" android:clickable="true" />
                        <View android:id="@+id/themeGreen" android:layout_width="45dp" android:layout_height="45dp" android:layout_margin="8dp" android:background="#00FF85" android:focusable="true" android:clickable="true" />
                        <View android:id="@+id/themePurple" android:layout_width="45dp" android:layout_height="45dp" android:layout_margin="8dp" android:background="#A020F0" android:focusable="true" android:clickable="true" />
                        <View android:id="@+id/themeOrange" android:layout_width="45dp" android:layout_height="45dp" android:layout_margin="8dp" android:background="#FF8C00" android:focusable="true" android:clickable="true" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="8dp">
                        <View android:id="@+id/themePink" android:layout_width="45dp" android:layout_height="45dp" android:layout_margin="8dp" android:background="#FF69B4" android:focusable="true" android:clickable="true" />
                        <View android:id="@+id/themeLime" android:layout_width="45dp" android:layout_height="45dp" android:layout_margin="8dp" android:background="#32CD32" android:focusable="true" android:clickable="true" />
                        <View android:id="@+id/themeSilver" android:layout_width="45dp" android:layout_height="45dp" android:layout_margin="8dp" android:background="#C0C0C0" android:focusable="true" android:clickable="true" />
                        <View android:id="@+id/themeDeepBlue" android:layout_width="45dp" android:layout_height="45dp" android:layout_margin="8dp" android:background="#0000FF" android:focusable="true" android:clickable="true" />
                        <View android:id="@+id/themeYellow" android:layout_width="45dp" android:layout_height="45dp" android:layout_margin="8dp" android:background="#FFFF00" android:focusable="true" android:clickable="true" />
                        <View android:id="@+id/themeWhite" android:layout_width="45dp" android:layout_height="45dp" android:layout_margin="8dp" android:background="#FFFFFF" android:focusable="true" android:clickable="true" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Wallpaper Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Arxa Fon Seçimi"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/bg_sidebar"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/glass_card_bg">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvWallpapers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:focusable="true"
                        android:clickable="true"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">

                        <Button
                            android:id="@+id/btnUploadImage"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ŞƏKİL YÜKLƏ"
                            android:layout_marginEnd="8dp"
                            android:backgroundTint="@color/gold_dark"
                            android:textColor="@color/white" />

                        <Button
                            android:id="@+id/btnUploadVideo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="VİDEO YÜKLƏ"
                            android:backgroundTint="@color/gold_dark"
                            android:textColor="@color/white" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnResetWallpaper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="STANDART FONA QAYIT"
                        android:backgroundTint="@color/glass_white_heavy"
                        android:textColor="@color/white" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/legal_info"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/bg_sidebar"
                android:layout_marginBottom="60dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/glass_card_bg">

                    <Button
                        android:id="@+id/btnPrivacyPolicy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/privacy_policy_title"
                        android:backgroundTint="@color/glass_white_heavy"
                        android:textColor="@color/white" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Version & Update Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Proqram Məlumatı"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/bg_sidebar"
                android:layout_marginBottom="60dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/glass_card_bg">

                    <TextView
                        android:id="@+id/tvAppVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Versiya: --"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btnCheckUpdate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="YENİLƏMƏNİ YOXLA"
                        android:backgroundTint="@color/gold_dark"
                        android:textColor="@color/white" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
