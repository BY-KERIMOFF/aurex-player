<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Panoramic Background -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerViewBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:resize_mode="fill"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/ivAppBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/app_background"
        android:scaleType="centerCrop" />

    <!-- Dark Overlay for Readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000" />

    <!-- Main Dashboard -->
    <ScrollView
        android:id="@+id/dashboardLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbarThumbVertical="@null">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:paddingTop="15dp"
            android:paddingBottom="40dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:elevation="10dp">

                <ProgressBar
                    android:id="@+id/pbDashboardLoading"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/titleContainer"
                    android:layout_marginStart="16dp"
                    android:indeterminateTint="@color/gold_primary"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/titleContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_centerVertical="true">

                    <TextView
                        android:id="@+id/tvAppTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AUREX PLAYER"
                        android:textColor="@color/white"
                        android:textSize="40sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.2"
                        android:fontFamily="sans-serif-black"
                        android:shadowColor="#CC000000"
                        android:shadowDx="4"
                        android:shadowDy="4"
                        android:shadowRadius="8" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <!-- Weather Section -->
                    <LinearLayout
                        android:id="@+id/weatherLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginEnd="24dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvWeatherEmoji"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="☀️"
                            android:textSize="32sp" />

                        <TextView
                            android:id="@+id/tvTemperature"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="--°C"
                            android:textColor="@color/white"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Clock Section -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <!-- Test Rejimi Banner -->
                        <LinearLayout
                            android:id="@+id/testBanner"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end"
                            android:visibility="gone"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/glass_card_bg"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp">

                            <TextView
                                android:id="@+id/testTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🧪 TEST REJİMİ"
                                android:textColor="@color/gold_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/testWarning"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⚠️ Test vaxtı bitir!"
                                android:textColor="#fbbf24"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                android:layout_marginTop="2dp" />

                            <TextView
                                android:id="@+id/testCountdown"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⏱ 00:00:00"
                                android:textColor="@color/gold_primary"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:id="@+id/testExpireLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bitir: --"
                                android:textColor="#80FFFFFF"
                                android:textSize="12sp"
                                android:visibility="gone"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <TextClock
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:format12Hour="HH:mm"
                            android:format24Hour="HH:mm"
                            android:textColor="@color/white"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cümə, 24 İyul"
                            android:textColor="@color/text_secondary"
                            android:textSize="16sp" />
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>

            <TextView
                android:id="@+id/tvExpiryInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/gold_dark"
                android:textSize="16sp"
                android:layout_marginBottom="24dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/cardsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="4">

                <!-- Live TV -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardLiveTv"
                    android:layout_width="0dp"
                    android:layout_height="170dp"
                    android:layout_weight="1"
                    android:layout_margin="8dp"
                    android:focusable="true"
                    android:clickable="true"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="0dp"
                    android:backgroundTint="@color/bg_sidebar">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/glass_card_bg">
                        <ImageView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:src="@android:drawable/ic_menu_slideshow"
                            app:tint="@color/gold_primary" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CANLI TV"
                            android:textColor="@color/white"
                            android:layout_marginTop="12dp"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Movies -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardMovies"
                    android:layout_width="0dp"
                    android:layout_height="170dp"
                    android:layout_weight="1"
                    android:layout_margin="8dp"
                    android:focusable="true"
                    android:clickable="true"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="0dp"
                    android:backgroundTint="@color/bg_sidebar">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/glass_card_bg">
                        <ImageView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:src="@android:drawable/ic_menu_gallery"
                            app:tint="@color/gold_primary" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FİLMLƏR"
                            android:textColor="@color/white"
                            android:layout_marginTop="12dp"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Series -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardSeries"
                    android:layout_width="0dp"
                    android:layout_height="170dp"
                    android:layout_weight="1"
                    android:layout_margin="8dp"
                    android:focusable="true"
                    android:clickable="true"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="0dp"
                    android:backgroundTint="@color/bg_sidebar">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/glass_card_bg">
                        <ImageView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:src="@android:drawable/ic_menu_sort_by_size"
                            app:tint="@color/gold_primary" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SERİALLAR"
                            android:textColor="@color/white"
                            android:layout_marginTop="12dp"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Favorites -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardFavorites"
                    android:layout_width="0dp"
                    android:layout_height="170dp"
                    android:layout_weight="1"
                    android:layout_margin="8dp"
                    android:focusable="true"
                    android:clickable="true"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="0dp"
                    android:backgroundTint="@color/bg_sidebar">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/glass_card_bg">
                        <ImageView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:src="@android:drawable/btn_star_big_on"
                            app:tint="@color/gold_primary" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SEVİMLİLƏR"
                            android:textColor="@color/white"
                            android:layout_marginTop="12dp"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Dedicated Radio Section (New Row) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Musiqi və Əyləncə"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="10dp"
                android:alpha="0.8" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardRadio"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_margin="10dp"
                android:focusable="true"
                android:clickable="true"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                android:backgroundTint="@color/bg_sidebar">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp"
                    android:background="@drawable/glass_card_bg">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/ic_lock_silent_mode_off"
                        android:scaleType="fitCenter"
                        app:tint="@color/gold_primary" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="24dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ONLAYN RADİO"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dünyanın ən populyar və yerli radio stansiyaları"
                            android:textColor="@color/gold_dark"
                            android:textSize="12sp"
                            android:alpha="0.9" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_media_play"
                        app:tint="@color/white"
                        android:alpha="0.5" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Dedicated Speed Test Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Şəbəkə Diaqnostikası"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="10dp"
                android:alpha="0.8" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardSpeedTest"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_margin="10dp"
                android:focusable="true"
                android:clickable="true"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                android:backgroundTint="@color/bg_sidebar">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp"
                    android:background="@drawable/glass_card_bg">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/ic_menu_compass"
                        android:scaleType="fitCenter"
                        app:tint="@color/gold_primary" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="24dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SÜRƏT TESTİ"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="İnternet bağlantınızın keyfiyyətini yoxlayın"
                            android:textColor="@color/gold_dark"
                            android:textSize="12sp"
                            android:alpha="0.9" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YOXLA"
                        android:textColor="@color/gold_primary"
                        android:textStyle="bold"
                        android:alpha="0.8" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Kids Mode Section -->
            <TextView
                android:id="@+id/tvKidsModeSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Valideyn Nəzarəti"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="10dp"
                android:alpha="0.8" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardKidsMode"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_margin="10dp"
                android:focusable="true"
                android:clickable="true"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                android:backgroundTint="@color/bg_sidebar">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp"
                    android:background="@drawable/glass_card_bg">
                    <ImageView
                        android:id="@+id/ivKidsModeIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/ic_menu_view"
                        android:scaleType="fitCenter"
                        app:tint="@color/gold_primary" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="24dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvKidsModeTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UŞAQ REJİMİ"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvKidsModeSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Yalnız uşaqlar üçün kontent"
                            android:textColor="@color/gold_dark"
                            android:textSize="12sp"
                            android:alpha="0.9" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvKidsModeAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AKTİV ET"
                        android:textColor="@color/gold_primary"
                        android:textStyle="bold"
                        android:alpha="0.8" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>



            <!-- İzləməyə Davam Et Section -->
            <LinearLayout
                android:id="@+id/resumeSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="İZLƏMƏYƏ DAVAM ET"
                    android:textColor="@color/gold_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginStart="10dp"
                    android:letterSpacing="0.1" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvResume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:paddingEnd="20dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
            </LinearLayout>

            <!-- Valyuta Məzənnələri Section -->
            <LinearLayout
                android:id="@+id/currencySection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GÜNLÜK MƏZƏNNƏLƏR (AZN)"
                    android:textColor="@color/gold_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginStart="10dp"
                    android:letterSpacing="0.1" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCurrencies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:paddingEnd="20dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="end">

                <Button
                    android:id="@+id/btnSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AYARLAR"
                    android:backgroundTint="@color/glass_white_heavy"
                    android:textColor="@color/white"
                    android:layout_marginEnd="16dp" />

                <Button
                    android:id="@+id/btnSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AXTARIŞ"
                    android:backgroundTint="@color/gold_dark"
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Error/Expired Dialog Overlay -->
    <LinearLayout
        android:id="@+id/errorOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F20A0A0A"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="50dp">

        <TextView
            android:id="@+id/errorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xəta"
            android:textColor="@android:color/holo_red_light"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/errorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Mesaj bura gələcək"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/macDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="MAC: 00:00:00:00:00"
            android:textColor="@color/gold_primary"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="Təkrar Yoxla"
            android:backgroundTint="@color/white"
            android:textColor="@color/black" />

    </LinearLayout>

    <!-- Premium Loading State (Splash Screen) -->
    <FrameLayout
        android:id="@+id/loadingLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="visible"
        android:elevation="1000dp">

        <!-- Splash Background for Zoom Effect -->
        <ImageView
            android:id="@+id/ivSplashBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/app_background"
            android:alpha="0.6" />

        <!-- Vignette for focus -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/vignette_overlay" />

        <TextView
            android:id="@+id/tvEnjoyWatching"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="AUREX PLAYER"
            android:textColor="@color/white"
            android:textSize="54sp"
            android:textStyle="bold"
            android:visibility="invisible"
            android:letterSpacing="0.2"
            android:fontFamily="sans-serif-condensed" />
    </FrameLayout>

</FrameLayout>
